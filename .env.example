VITE_API_BASE_URL=/api
# true: 명시적인 예시 데이터, false: 실제 API (실패 시 데모로 대체하지 않음)
VITE_DEMO_MODE=true

# 이용 가이드에서 실제 서버 상태와 서울 자치구 조회를 별도로 확인합니다.
VITE_SERVICE_API_PREVIEW=false
# Vite 개발용 /api 프록시. 필요할 때 서버 origin을 넣습니다(예: http://localhost:8080).
PICKPLACE_API_PROXY_TARGET=

# 카카오 JavaScript 앱 키 (REST API 키 사용 불가). 지도와 행정동 위치 조회에 사용합니다.
# 해당 키의 허용 도메인에 실제 출처 등록: http://localhost:5173, http://127.0.0.1:5173
VITE_KAKAO_MAP_APP_KEY=
