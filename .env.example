VITE_API_BASE_URL=/api
# true: 명시적인 예시 데이터, false: 실제 API (실패 시 데모로 대체하지 않음)
VITE_DEMO_MODE=true

# auto: 카카오(키 설정 시) → 대체 타일(설정 시) → OSM
# kakao | custom | osm | schematic 도 직접 지정할 수 있습니다.
# 명시한 서비스 설정이 없으면 OSM으로 바꾸지 않고 기본 위치도로 표시합니다.
VITE_MAP_PROVIDER=auto
# 카카오 JavaScript 앱 키. Kakao Developers에서 서비스 URL 등록 필요.
VITE_KAKAO_MAP_APP_KEY=
# 허가받은 Web Mercator XYZ 래스터 타일 URL (HTTPS 또는 동일 출처 경로)
VITE_MAP_TILE_URL=
# 대체 타일 제공자가 요구하는 출처 표기. URL과 함께 설정해야 활성화됩니다.
VITE_MAP_ATTRIBUTION=
VITE_MAP_MAX_ZOOM=19
